# Copy to .env (kept private, git-ignored). start.command loads it automatically.

# --- Data location -------------------------------------------------------
# Leave WORD_COACH_VAULT unset to use the bundled sample/ words.
# Set it to your Obsidian vault to use your own list and write notes there:
#   <vault>/Vocabulary/Youdao Vocabulary.csv        (source_number,word,extraction_status,source_image)
#   <vault>/Source Material/Vocabulary/*.md         (notes + _Review Log.md)
# WORD_COACH_VAULT=/path/to/your/vault
# WORD_COACH_CSV=/path/to/vocabulary.csv            # optional override
# WORD_COACH_NOTES_DIR=/path/to/notes               # optional override
# WORD_COACH_CONTEXTS=/path/to/contexts.json        # optional: your own word meanings/examples
# WORD_COACH_PORT=8765

# --- Optional "Ask AI" panel ---------------------------------------------
# Or configure provider/token in the app's Settings (saved to .word-coach-settings.json).
OPENAI_API_KEY=
WORD_COACH_AI_MODEL=gpt-5.6-luna
